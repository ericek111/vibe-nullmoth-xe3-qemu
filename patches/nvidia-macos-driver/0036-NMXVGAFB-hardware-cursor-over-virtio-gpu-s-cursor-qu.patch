     bool submitNoData(const void *cmd, uint32_t cmdLen, const char *what);
diff --git a/kexts/NMXVGAFB/nmxvgafb.cpp b/kexts/NMXVGAFB/nmxvgafb.cpp
index a526e79..326127f 100644
--- a/kexts/NMXVGAFB/nmxvgafb.cpp
+++ b/kexts/NMXVGAFB/nmxvgafb.cpp
@@ -61,6 +61,17 @@ class NMXVGAFB : public IOFramebuffer {
