+        if (IOMemoryMap *m = vm->map(kIOMapReadOnly)) {
+            memcpy(fScanBuf->getBytesNoCopy(), (const void *)m->getVirtualAddress(), (size_t)fRowBytes * fHeight);
+            m->release();
+        }
+        vm->release();
+    }
+    if (!fVirtio.createBlob(kScanResource, phys, bytes) ||
+        !fVirtio.setScanoutBlob(kScanResource, fWidth, fHeight, fRowBytes) ||
+        !fVirtio.flush(kScanResource, 0, 0, fWidth, fHeight)) {
