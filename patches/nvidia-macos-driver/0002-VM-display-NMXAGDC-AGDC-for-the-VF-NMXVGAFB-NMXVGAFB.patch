+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_refused); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_last_refused);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_link);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_caps); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_why);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_fbmap); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_maxfb);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_rescans);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_asked); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_link_mask);
+    sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_caps_mask); sysctl_unregister_oid(&sysctl__debug_nmxfb_agdc_k5_last_refused_idx);
+}
+static void nvdaAgdcInstallSysctl(void)
+{
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_cmds);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_refused); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_last_refused);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_link);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_caps); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_why);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_fbmap); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_maxfb);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_rescans);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_asked); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_link_mask);
+    sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_caps_mask); sysctl_register_oid(&sysctl__debug_nmxfb_agdc_k5_last_refused_idx);
+}
