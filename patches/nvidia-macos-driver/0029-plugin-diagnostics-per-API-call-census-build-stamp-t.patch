From fc0ad44c34aa186c9dd44f9f6766ed11fb1803b8 Mon Sep 17 00:00:00 2001
From: ericek111 <erik.brocko@letemsvetemapplem.eu>
Date: Sat, 17 Oct 2026 05:15:13 +0200
Subject: [PATCH 29/47] plugin: diagnostics - per-API call census, build stamp,
 the first function constant in the log

- apistat: counts per Metal entry point (draws with vertex/index/instance totals, dispatches, encoders, commits,
  waits with time, buffer creation, uploads/readbacks), logged per second every 2 s while /tmp/nvmtl-apistat exists.
  It showed Minecraft's ~50k draws per frame, each paired with a compute dispatch.
- +load logs "build <NVMTL_STAMP>"; vm/tools/pcycle.sh stamps every build and refuses to install one without it.
- newFunctionWithName:constantValues: logs the first constant's value (it identified fixIndexBuffer's conversions).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugin/NVMTLDevice.m  | 41 +++++++++++++++++++++++++++++++++++++----
 plugin/NVMTLObjects.m | 29 ++++++++++++++++-------------
 2 files changed, 53 insertions(+), 17 deletions(-)

diff --git a/plugin/NVMTLDevice.m b/plugin/NVMTLDevice.m
index bb6e501..a9acf8d 100644
--- a/plugin/NVMTLDevice.m
+++ b/plugin/NVMTLDevice.m
@@ -143,6 +143,36 @@ static void nvmtl_alloc_failed(const char *what) {
 @interface NVMTLDevice : MTLIOAccelDevice <MTLDevice, MTLDeviceSPI>
 @end
 #import "NVMTLObjects.h"
+/* API call census: counts (and for waits, time) per Metal entry point, logged every 2 s as "apistat" while the file
+   /tmp/nvmtl-apistat exists (checked every 2 s). Shows what an app's frames are made of (Minecraft through Apple's
+   GL-over-Metal: draws, compute dispatches, command buffers, CPU waits). Counting is a relaxed atomic add. */
+enum { NVS_DRAW, NVS_DRAWIDX, NVS_DISPATCH, NVS_RENC, NVS_CENC, NVS_BENC, NVS_COMMIT, NVS_WAIT, NVS_WAITNS, NVS_NEWBUF,
+       NVS_NEWBUFBYTES, NVS_REPLACE, NVS_GETBYTES, NVS_MODRANGE, NVS_SETBUF, NVS_SETBYTES, NVS_SETTEX, NVS_SETPSO, NVS_DRAWVERTS, NVS_IDXCOUNT, NVS_INSTANCES, NVS_N };
+static const char *const nvs_name[NVS_N] = { "draw", "drawidx", "dispatch", "renc", "cenc", "benc", "commit", "wait",
+    "wait_ms", "newbuf", "newbuf_kb", "replace", "getbytes", "modrange", "setbuf", "setbytes", "settex", "setpso", "verts", "indices", "instances" };
+static _Atomic unsigned long long g_nvs[NVS_N];
+static void nvmtl_apistat_tick(void);
+static inline void NVS(int k) { atomic_fetch_add_explicit(&g_nvs[k], 1, memory_order_relaxed); }
+static inline void NVSN(int k, unsigned long long n) { atomic_fetch_add_explicit(&g_nvs[k], n, memory_order_relaxed); }
+static void nvmtl_apistat_tick(void)
+{
+    static _Atomic unsigned long long next; static unsigned long long last[NVS_N]; static int on;
+    const unsigned long long now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW), n = atomic_load(&next);
+    if (now < n || !atomic_compare_exchange_strong(&next, &(unsigned long long){ n }, now + 2000000000ull)) return;
+    const int was = on; on = access("/tmp/nvmtl-apistat", F_OK) == 0;
+    unsigned long long v[NVS_N];
+    for (int k = 0; k < NVS_N; k++) v[k] = atomic_load_explicit(&g_nvs[k], memory_order_relaxed);
+    if (on && was && n) {
+        char line[900]; int o = 0;
+        for (int k = 0; k < NVS_N && o < (int)sizeof line - 40; k++) {
+            unsigned long long d = v[k] - last[k];
+            if (k == NVS_WAITNS) d /= 1000000ull; else if (k == NVS_NEWBUFBYTES) d >>= 10;
+            if (d) o += snprintf(line + o, sizeof line - (size_t)o, " %s %llu", nvs_name[k], d / 2);
+        }
+        nvlog("apistat per second:%s", line);
+    }
+    memcpy(last, v, sizeof v);
+}
 void nvmtl_vendor_compile_airs(NSDictionary<NSString *, NSString *> *airs,
                                NSDictionary<NSString *, NSString *> *stages);
 void nvmtl_vendor_attach_sass(id device, id pipelineState, id function);
