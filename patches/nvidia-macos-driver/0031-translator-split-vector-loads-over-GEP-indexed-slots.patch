+        slot: &str,
+        lanes: usize,
+        ptr_prefix: &str,
+        ptr_name: &str,
+    ) -> Vec<String> {
+        let vty = format!("<{lanes} x {elem}>");
+        let mut lines = Vec::new();
+        for k in 0..lanes {
+            let x = self.fresh();
+            let c = self.fresh();
+            let p = self.fresh();
+            lines.push(format!("  {x} = extractelement {vty} {value}, i32 {k}"));
+            lines.push(format!("  {c} = bitcast {elem} {x} to {slot}"));
+            lines.push(format!(
+                "  {p} = getelementptr inbounds {slot}, {ptr_prefix} {ptr_name}, i64 {k}"
+            ));
+            lines.push(format!("  store {slot} {c}, {ptr_prefix} {p}, align 4"));
+        }
+        lines
+    }
