+    #[test]
+    fn gep_indexed_slots_read_as_other_same_width_vector_are_split_with_bitcasts() {
+        // Apple's GL compiler: a GLSL `ivec3` at the start of a uniform block, addressed as `getelementptr float`.
+        let src = "\
+define void @k(ptr addrspace(2) %ubo) {
+entry:
+  %p = getelementptr float, ptr addrspace(2) %ubo, i32 0
+  %v = load <3 x i32>, ptr addrspace(2) %p, align 16
+  ret void
+}
+";
+        assert_eq!(lower_impl(src, false), src);
+        let out = lower_impl(src, true);
+        assert!(!out.contains("load <3 x i32>"), "{out}");
+        assert_eq!(out.matches("load float,").count(), 3, "{out}");
+        assert_eq!(out.matches("bitcast float ").count(), 3, "{out}");
+        assert!(out.contains("%v = insertelement <3 x i32>"), "{out}");
+    }
