+int nvmtl_vk_cmd_set_topology_restart(nvk_cmdbuf *c, unsigned mtlType, int restart) {
     static const VkPrimitiveTopology map[5] = { VK_PRIMITIVE_TOPOLOGY_POINT_LIST, VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
