diff --git a/plugin/NVMTLDevice.m b/plugin/NVMTLDevice.m
index 8fe8bc8..bb6e501 100644
--- a/plugin/NVMTLDevice.m
+++ b/plugin/NVMTLDevice.m
@@ -9,6 +9,7 @@
 #import <objc/runtime.h>
 #import <objc/message.h>
 #import <mach/mach.h>
+#include <mach-o/getsect.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -449,8 +450,40 @@ static void nvmtl_install_hw_resource_pools(id dev)
     @synchronized(seen) { NSString *k = @(who); if (![seen containsObject:k]) { [seen addObject:k]; nvlog("vendorName -> %s (asked by %s)", v.UTF8String, who); } }
     return v;
 }
+/* Apple's GL-over-Metal renderer (AppleMetalOpenGLRenderer) picks a capability table by the device name: "Intel" gets
+   0x144 (macOS 26.7), which lacks bit 3, "the encoder takes setProvokingVertexMode:". Without it GL's default
+   last-vertex convention is emulated by rewriting every draw's index buffer in a compute pass (fixIndexBuffer): a
+   compute dispatch per draw, which held Minecraft at ~1 fps. This device has last-vertex mode (setProvokingVertexMode:
+   on the render encoder), so the bit is set in that table, once, when the renderer first asks for the name - right
+   before it reads the table. The table is found by its exact bytes, followed by the NVIDIA one (0x140); anything else
+   is left alone. */
+static void nvmtl_amgl_caps(const void *caller)
+{
+    static int done;
+    Dl_info di;
+    if (done || !dladdr(caller, &di) || !di.dli_fname || !strstr(di.dli_fname, "/AppleMetalOpenGLRenderer")) return;
+    done = 1;
+    if (!nvmtl_vk_have_provoking_last()) { nvlog("GL renderer caps: no last-vertex mode - its per-draw index rewrite stays"); return; }
+    unsigned long sz = 0;
+    uint8_t *sec = getsectiondata((const struct mach_header_64 *)di.dli_fbase, "__TEXT", "__const", &sz);
+    static const uint8_t intel[20] = { 0x44, 0x01, 0, 0, 0, 0, 0, 0, 0, 0, 0x80, 0x42, 0, 0, 0x80, 0x41, 0, 0, 0, 0 };
+    static const uint8_t nvidia[16] = { 0x40, 0x01, 0, 0, 0, 0, 0, 0, 0, 0, 0x80, 0x42, 0, 0, 0x80, 0x41 };
+    uint8_t *hit = NULL; unsigned n = 0;
+    for (unsigned long k = 0; sec && k + 36 <= sz; k += 4)
+        if (!memcmp(sec + k, intel, sizeof intel) && !memcmp(sec + k + 20, nvidia, sizeof nvidia)) { hit = sec + k; n++; }
+    if (n != 1) { nvlog("GL renderer caps: the Intel table was not found exactly once (%u) - left alone", n); return; }
+    const vm_address_t page = (vm_address_t)hit & ~(vm_address_t)(vm_page_size - 1);
+    kern_return_t kr = vm_protect(mach_task_self(), page, vm_page_size, FALSE, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY);
+    if (kr == KERN_SUCCESS) {
+        hit[0] |= 0x08;
+        kr = vm_protect(mach_task_self(), page, vm_page_size, FALSE, VM_PROT_READ | VM_PROT_EXECUTE);
+    }
+    nvlog("GL renderer caps: provoking-vertex bit %s (Intel table at %p: 0x%x, vm_protect %d)", kr == KERN_SUCCESS ? "SET" : "NOT set",
+          (void *)hit, hit[0], kr);
+}
 - (NSString *)name {
     static int vk = 0; if (!vk) { vk = 1; nvmtl_vk_init(); }
+    nvmtl_amgl_caps(__builtin_return_address(0));
     const char *vkname = nvmtl_vk_device_name();
     NSString *full = [NSString stringWithUTF8String:(vkname ? vkname : "NVIDIA GPU")];
     NSRange cut = [full rangeOfString:@" (NVK "];
