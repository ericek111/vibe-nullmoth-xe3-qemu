+// Apple's GL-over-Metal renderer carries GL's primitive restart state through this AGX SPI (types v20@0:8c16 and
+// v28@0:8c16Q20 in AGXMetalG13X); answered, it stops rewriting index buffers on the GPU before every draw. Vulkan
+// restarts only at the all-ones index of the bound index type, GL's usual (and GL 4.3's fixed) restart index.
+// AGX SPI (v24@0:8Q16): Apple's GL renderer passes GL's provoking-vertex convention, non-zero for last-vertex (GL's
+// default). Answered only where the device has last-vertex mode; the renderer then stops rotating indices per draw.
+- (void)setProvokingVertexMode:(NSUInteger)mode {
+    if (nvmtl_vk_cmd_set_provoking(&_cb->_c, mode != 0)) { static int said; if (!said++) nvlog("setProvokingVertexMode:%lu - no last-vertex mode on this device, flat varyings take the first vertex", (unsigned long)mode); }
+}
+- (void)setPrimitiveRestartEnabled:(BOOL)on { _prMode = on ? 2 : 1; _prIndex = ~(NSUInteger)0; }
+- (void)setPrimitiveRestartEnabled:(BOOL)on index:(NSUInteger)index {
+    if (on && index != 0xFFFF && index != 0xFFFFFFFFu && index != ~(NSUInteger)0) {
+        static int said; if (said++ < 4) nvlog("primitive restart index 0x%lx is not all-ones: strips restart at the all-ones index only", (unsigned long)index); }
+    _prMode = on ? 2 : 1; _prIndex = index;
+}
 - (void)setStencilReferenceValue:(uint32_t)ref { nvmtl_vk_cmd_set_stencil_ref(&_cb->_c, ref, ref); _hasRef = YES; }
 - (void)setStencilFrontReferenceValue:(uint32_t)f backReferenceValue:(uint32_t)b { nvmtl_vk_cmd_set_stencil_ref(&_cb->_c, f, b); _hasRef = YES; }
 - (void)setDepthBias:(float)bias slopeScale:(float)slope clamp:(float)clamp { nvmtl_vk_cmd_set_depth_bias(&_cb->_c, bias, slope, clamp); }
