From 98a0b2225c949db4f5694bde29a4bbbd1eebd601 Mon Sep 17 00:00:00 2001
From: ericek111 <erik.brocko@letemsvetemapplem.eu>
Date: Fri, 16 Oct 2026 05:48:57 +0200
Subject: [PATCH 20/50] spin mutexes nest in the per-CPU critical count
 (per-lock saved IRQ state left interrupts off after out-of-order unlocks)

---
 bsdcompat/src/nmx_lock.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/gpu-port/xkpi/bsdcompat/src/nmx_lock.c b/gpu-port/xkpi/bsdcompat/src/nmx_lock.c
index d699d09..430856c 100644
--- a/gpu-port/xkpi/bsdcompat/src/nmx_lock.c
+++ b/gpu-port/xkpi/bsdcompat/src/nmx_lock.c
@@ -18,6 +18,8 @@
 #include <kern/locks.h>
 
 extern boolean_t ml_set_interrupts_enabled(boolean_t enable);
+void nmx_critical_enter(void);   /* nmx_kernel.c: per-CPU interrupts-off nesting */
+void nmx_critical_exit(void);
 /* exported to kexts (verified by tools/kpi_probe.sh) but not declared in the SDK headers */
 extern boolean_t lck_mtx_try_lock(lck_mtx_t *lck);
 extern boolean_t lck_spin_try_lock(lck_spin_t *lck);
@@ -75,9 +77,14 @@ void nmx_mtx_lock(struct mtx *m)
         return;
     }
     if (m->lock_object.lo_class == NMX_LC_SPIN) {
-        boolean_t was = ml_set_interrupts_enabled(FALSE);
+        /*
+         * Spin mutexes nest in the same per-CPU interrupts-off count as critical sections. Each lock used to keep the
+         * interrupt state of its own lock call, so releasing two spin locks out of order (A, B, unlock A, unlock B)
+         * turned interrupts back on inside B and finally left them off: every DRM entry point returned to user space
+         * with interrupts disabled, and the process later panicked in workq_exit.
+         */
+        nmx_critical_enter();
         lck_spin_lock(m->mtx_lk);
-        m->mtx_saved_intr = was;
     } else {
         lck_mtx_lock(m->mtx_lk);
     }
@@ -94,12 +101,11 @@ int nmx_mtx_trylock(struct mtx *m)
         return 1;
     }
     if (m->lock_object.lo_class == NMX_LC_SPIN) {
-        boolean_t was = ml_set_interrupts_enabled(FALSE);
+        nmx_critical_enter();
         if (!lck_spin_try_lock(m->mtx_lk)) {
-            ml_set_interrupts_enabled(was);
+            nmx_critical_exit();
             return 0;
         }
-        m->mtx_saved_intr = was;
     } else if (!lck_mtx_try_lock(m->mtx_lk)) {
         return 0;
     }
@@ -116,9 +122,8 @@ void nmx_mtx_unlock(struct mtx *m)
     }
     m->mtx_owner = 0;
     if (m->lock_object.lo_class == NMX_LC_SPIN) {
-        boolean_t was = (boolean_t)m->mtx_saved_intr;
         lck_spin_unlock(m->mtx_lk);
-        ml_set_interrupts_enabled(was);
+        nmx_critical_exit();
     } else {
         lck_mtx_unlock(m->mtx_lk);
     }
