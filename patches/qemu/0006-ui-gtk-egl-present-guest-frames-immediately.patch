+static void gd_hw_gl_unblock(VirtualConsole *vc)
+{
+    vc->gfx.frame_released_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    qemu_console_hw_gl_block(vc->gfx.dcl.con, false);
+}
+
+static void gd_hw_gl_frame_timer(void *opaque)
+{
+    gd_hw_gl_unblock(opaque);
+}
+
+#ifdef GD_VBLANK_PACING
+/*
+ * When the DRM device driving the console's monitor can be opened, read
+ * the hardware vblank timestamps of its CRTC (this works without being DRM
+ * master, so it doesn't interfere with the compositor).  X11 clients have
+ * no other accurate way of knowing when the compositor's frames start;
+ * Xwayland's MSC/UST and GTK's frame timings are estimates at best.
+ */
+static const char *const gd_drm_connector_names[] = {
+    "Unknown", "VGA", "DVI-I", "DVI-D", "DVI-A", "Composite", "SVIDEO",
+    "LVDS", "Component", "DIN", "DP", "HDMI-A", "HDMI-B", "TV", "eDP",
+    "Virtual", "DSI", "DPI", "Writeback", "SPI", "USB",
+};
+
+static bool gd_drm_find_crtc(int fd, const char *monitor, uint32_t *crtc,
+                             int64_t *period_ns)
+{
+    struct drm_mode_card_res res = { 0 };
+    g_autofree uint32_t *conns = NULL;
+    uint32_t i;
+
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res) || !res.count_connectors) {
+        return false;
+    }
+    conns = g_new0(uint32_t, res.count_connectors);
+    res = (struct drm_mode_card_res) {
+        .connector_id_ptr = (uintptr_t)conns,
+        .count_connectors = res.count_connectors,
+    };
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res)) {
+        return false;
+    }
+    for (i = 0; i < res.count_connectors; i++) {
+        struct drm_mode_get_connector c = { .connector_id = conns[i] };
+        struct drm_mode_get_encoder e = { 0 };
+        struct drm_mode_crtc m = { 0 };
+        g_autofree char *name = NULL;
+
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &c) ||
+            c.connector_type >= ARRAY_SIZE(gd_drm_connector_names)) {
+            continue;
+        }
+        name = g_strdup_printf("%s-%u",
+                               gd_drm_connector_names[c.connector_type],
+                               c.connector_type_id);
+        if (strcmp(name, monitor) || !c.encoder_id) {
+            continue;
+        }
+        e.encoder_id = c.encoder_id;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETENCODER, &e) || !e.crtc_id) {
+            return false;
+        }
+        m.crtc_id = e.crtc_id;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCRTC, &m) || !m.mode_valid ||
+            !m.mode.clock) {
+            return false;
+        }
+        *crtc = e.crtc_id;
+        *period_ns = (int64_t)m.mode.htotal * m.mode.vtotal * 1000000 /
+                     m.mode.clock;
+        return true;
+    }
+    return false;
+}
+
+static void gd_vblank_update(VirtualConsole *vc, GdkMonitor *monitor,
+                             int refresh_rate)
+{
+    const char *name = monitor ? gdk_monitor_get_model(monitor) : NULL;
+    int card;
+
+    if (!g_strcmp0(name, vc->gfx.vblank_monitor) &&
+        refresh_rate == vc->gfx.vblank_refresh) {
+        return;
+    }
+    if (vc->gfx.vblank_fd >= 0) {
+        close(vc->gfx.vblank_fd);
+        vc->gfx.vblank_fd = -1;
+    }
+    g_free(vc->gfx.vblank_monitor);
+    vc->gfx.vblank_monitor = g_strdup(name);
+    vc->gfx.vblank_refresh = refresh_rate;
+    if (!name) {
+        return;
+    }
+    for (card = 0; card < 16; card++) {
+        g_autofree char *path = g_strdup_printf("/dev/dri/card%d", card);
+        int fd = open(path, O_RDWR | O_CLOEXEC);
+
+        if (fd < 0) {
+            continue;
+        }
+        if (gd_drm_find_crtc(fd, name, &vc->gfx.vblank_crtc,
+                             &vc->gfx.vblank_period_ns)) {
+            vc->gfx.vblank_fd = fd;
+            trace_gd_vblank_source(name, card, vc->gfx.vblank_crtc,
+                                   vc->gfx.vblank_period_ns);
+            return;
+        }
+        close(fd);
+    }
+    trace_gd_vblank_source(name, -1, 0, 0);
+}
+
+static bool gd_vblank_last(VirtualConsole *vc, int64_t *vblank_ns)
+{
+    struct drm_crtc_get_sequence seq = { .crtc_id = vc->gfx.vblank_crtc };
+
+    if (vc->gfx.vblank_fd < 0 ||
+        ioctl(vc->gfx.vblank_fd, DRM_IOCTL_CRTC_GET_SEQUENCE, &seq) ||
+        !seq.active) {
+        return false;
+    }
+    *vblank_ns = seq.sequence_ns;
+    return true;
+}
+
+/*
+ * When, after the start of a scanout, a guest frame should arrive so that
+ * the compositor still picks it up for the next refresh.  Measured with
+ * KWin 6.7 at 120 Hz: frames committed up to ~6.75 ms after the vblank
+ * timestamp make the next refresh; Xwayland and our own draw add a bit.
+ */
+static int64_t gd_vblank_phase_ns(void)
+{
+    static int64_t phase = -1;
+
+    if (phase < 0) {
+        const char *env = g_getenv("QEMU_GTK_VBLANK_PHASE_US");
+
+        phase = env ? g_ascii_strtoll(env, NULL, 10) * 1000 : 5000000;
+    }
+    return phase;
+}
+#endif
+
+/* How long before its target to release the guest for its next frame. */
+static int64_t gd_hw_gl_frame_lead(VirtualConsole *vc)
+{
+    return vc->gfx.frame_turnaround_ns + 2 * vc->gfx.frame_turnaround_dev_ns;
+}
+
+/* Called when the guest flushes a new frame after being released. */
+void gd_hw_gl_frame_arrived(VirtualConsole *vc)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t t = now - vc->gfx.frame_released_ns;
+    int64_t err;
+
+    if (!vc->gfx.frame_released_ns || t > vc->gfx.frame_interval_ns) {
+        /* the guest was idle, not a measure of its frame turnaround */
+        return;
+    }
+    /* running mean and mean deviation of the guest's frame turnaround */
+    err = t - vc->gfx.frame_turnaround_ns;
+    vc->gfx.frame_turnaround_ns += err / 16;
+    vc->gfx.frame_turnaround_dev_ns += (ABS(err) -
+                                        vc->gfx.frame_turnaround_dev_ns) / 16;
+    trace_gd_frame_arrived(now - vc->gfx.frame_target_ns, t,
+                           gd_hw_gl_frame_lead(vc));
+}
+
+/*
+ * Let the guest continue once a frame has been drawn, but at most once per
+ * host refresh interval.  Frames that are drawn as soon as they arrive are
+ * not paced by the window system, so without this a guest without vsync of
+ * its own renders frames much faster than they can be displayed.  Releases
+ * follow a fixed cadence rather than being an interval after the frame, so
+ * the time the guest takes to produce the next frame is not added on top.
+ */
+void gd_hw_gl_release(VirtualConsole *vc)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t next = vc->gfx.frame_release_ns + vc->gfx.frame_interval_ns;
+#ifdef GD_VBLANK_PACING
+    int64_t vblank;
+
+    /*
+     * With the real vblank known, release the guest so that its next frame
+     * arrives at a fixed phase of the host refresh, one frame per refresh.
+     * A free-running cadence drifts against the display and jitters around
+     * the compositor's deadline, which shows as repeated and skipped frames.
+     */
+    if (gd_vblank_last(vc, &vblank)) {
+        int64_t period = vc->gfx.vblank_period_ns;
+        int64_t target = vblank + gd_vblank_phase_ns();
+
+        /*
+         * Aim at the next target after the previous frame's.  If releasing
+         * now is already later than planned (a slow frame, or our own draw
+         * finished late), still go for it: the target leaves some slack
+         * before the compositor's deadline.  Only give up on it when even
+         * a quick guest frame can't make it.
+         */
+        while (target < vc->gfx.frame_target_ns + period / 2 ||
+               target < now + vc->gfx.frame_turnaround_ns / 2) {
+            target += period;
+        }
+        vc->gfx.frame_target_ns = target;
+        next = target - gd_hw_gl_frame_lead(vc);
+    }
+#endif
+
+    if (vc->gfx.frame_interval_ns && now < next) {
+        if (!vc->gfx.frame_timer) {
+            vc->gfx.frame_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                               gd_hw_gl_frame_timer, vc);
+        }
+        vc->gfx.frame_release_ns = next;
+        timer_mod(vc->gfx.frame_timer, next);
+        return;
+    }
+    vc->gfx.frame_release_ns = now;
+    gd_hw_gl_unblock(vc);
+}
