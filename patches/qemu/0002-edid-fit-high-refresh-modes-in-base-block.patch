diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index 2cb8196..f03d1a4 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -60,6 +60,18 @@ typedef struct Timings {
     uint64_t clock;
 } Timings;
 
+/*
+ * Pixel clock in 10 kHz units, rounded up so the mode's refresh rate is
+ * never below the requested one: Windows truncates refresh rates to whole
+ * Hz, so 119.999 Hz becomes a 119 Hz mode, one frame per second slower than
+ * a 120 Hz host.
+ */
+static uint64_t timings_clock(uint32_t refresh_rate, uint32_t htotal,
+                              uint32_t vtotal)
+{
+    return DIV_ROUND_UP((uint64_t)refresh_rate * htotal * vtotal, 10000000);
+}
+
 static void generate_timings(Timings *timings, uint32_t refresh_rate,
                              uint32_t xres, uint32_t yres)
 {
@@ -72,9 +84,28 @@ static void generate_timings(Timings *timings, uint32_t refresh_rate,
     timings->ysync  = yres *  5 / 1000;
     timings->yblank = yres * 35 / 1000;
 
-    timings->clock  = ((uint64_t)refresh_rate *
-                       (xres + timings->xblank) *
-                       (yres + timings->yblank)) / 10000000;
+    timings->clock  = timings_clock(refresh_rate, xres + timings->xblank,
+                                    yres + timings->yblank);
+}
+
+/*
+ * CVT reduced blanking v2 style timings: a virtual display has no beam to
+ * retrace, and the small blanking keeps the pixel clock of high refresh
+ * modes within what a base-block DTD can express (655.35 MHz).
+ */
+static void generate_timings_reduced(Timings *timings, uint32_t refresh_rate,
+                                     uint32_t xres, uint32_t yres)
+{
+    timings->xfront = 8;
+    timings->xsync  = 32;
+    timings->xblank = 80;
+
+    timings->yfront = 1;
+    timings->ysync  = 8;
+    timings->yblank = MAX(yres / 100, 15);
+
+    timings->clock  = timings_clock(refresh_rate, xres + timings->xblank,
+                                    yres + timings->yblank);
 }
 
 static void edid_ext_dta(uint8_t *dta)
@@ -224,13 +255,13 @@ static void edid_desc_ranges(uint8_t *desc)
 {
     edid_desc_type(desc, 0xfd);
 
-    /* vertical (50 -> 125 Hz) */
+    /* vertical (50 -> 255 Hz) */
     desc[5] =  50;
-    desc[6] = 125;
+    desc[6] = 255;
 
-    /* horizontal (30 -> 160 kHz) */
+    /* horizontal (30 -> 255 kHz), high refresh modes need > 200 kHz */
     desc[7] =  30;
-    desc[8] = 160;
+    desc[8] = 255;
 
     /* max dot clock (2550 MHz) */
     desc[9] = 2550 / 10;
@@ -391,6 +422,16 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
     uint32_t dpi = 100; /* if no width_mm/height_mm */
     uint32_t large_screen = 0;
 
+    /*
+     * Host refresh rates are often reported a little below the nominal
+     * rate (e.g. 119.962 Hz for a 120 Hz panel under Xwayland).  Guests
+     * that truncate to whole Hz would then run a frame per second slower
+     * than the host, so round rates within 0.1 Hz below a whole Hz up.
+     */
+    if (refresh_rate % 1000 >= 900) {
+        refresh_rate = QEMU_ALIGN_UP(refresh_rate, 1000);
+    }
+
     /* =============== set defaults  =============== */
 
     if (!info->vendor || strlen(info->vendor) != 3) {
@@ -415,6 +456,23 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
     }
 
     generate_timings(&timings, refresh_rate, info->prefx, info->prefy);
+    if (info->prefx < 4096 && info->prefy < 4096 && timings.clock >= 65536) {
+        /*
+         * The preferred mode fits a base-block DTD except for its pixel
+         * clock (e.g. a 2880x1800 window on a 120 Hz host).  Plenty of
+         * guest drivers only parse the base block, so rather than moving
+         * the preferred mode into a DisplayID extension, first switch to
+         * reduced blanking, and only if that is not enough lower the
+         * refresh rate until the clock fits.
+         */
+        generate_timings_reduced(&timings, refresh_rate,
+                                 info->prefx, info->prefy);
+        if (timings.clock >= 65536) {
+            refresh_rate = (uint64_t)refresh_rate * 65534 / timings.clock;
+            generate_timings_reduced(&timings, refresh_rate,
+                                     info->prefx, info->prefy);
+        }
+    }
     if (info->prefx >= 4096 || info->prefy >= 4096 || timings.clock >= 65536) {
         large_screen = 1;
     }
