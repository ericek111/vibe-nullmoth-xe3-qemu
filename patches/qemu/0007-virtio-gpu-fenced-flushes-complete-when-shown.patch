     warn_report("console: no gl-unblock within one second");
 }
 
+/*
+ * Called by a display that knows when a frame makes it to the screen: once the
+ * frame flushed last is drawn and has made the compositor's deadline for a
+ * refresh (or will at that refresh's latch point).
+ */
+void qemu_console_hw_frame_shown(QemuConsole *con)
+{
+    assert(con != NULL);
+    if (con->hw_ops->frame_shown) {
+        con->hw_ops->frame_shown(con->hw);
+    }
+}
+
 void qemu_console_hw_gl_block(QemuConsole *con, bool block)
 {
     uint64_t timeout;
@@ -192,6 +205,7 @@ void qemu_console_hw_gl_block(QemuConsole *con, bool block)
         con->gl_block--;
     }
     assert(con->gl_block >= 0);
+    trace_console_gl_block(con->index, block, con->gl_block);
     if (!con->hw_ops->gl_block) {
         return;
     }
diff --git a/ui/gtk.c b/ui/gtk.c
index 83e852f..a5d4b75 100644
--- a/ui/gtk.c
+++ b/ui/gtk.c
@@ -763,6 +763,75 @@ static int64_t gd_hw_gl_frame_lead(VirtualConsole *vc)
     return vc->gfx.frame_turnaround_ns + 2 * vc->gfx.frame_turnaround_dev_ns;
 }
 
+/*
+ * How far past a latch point a frame may arrive and still count for it: only
+ * the trip from the guest's flip to here.  A guest takes the latch point as
+ * its vblank, so a frame later than that was meant for the next refresh; a
+ * larger slack let frames flipped just after it count a refresh early.
+ */
+static int64_t gd_latch_slack_ns(void)
+{
+    static int64_t slack = -1;
+
+    if (slack < 0) {
+        const char *env = g_getenv("QEMU_GTK_LATCH_SLACK_US");
+        slack = env ? g_ascii_strtoll(env, NULL, 10) * 1000 : 250000;
+    }
+    return slack;
+}
+
+/*
+ * The latch point of the refresh a frame arriving now makes: the first
+ * vblank + phase it isn't too late for.  Without the vblank, the arrival.
+ */
+static int64_t gd_frame_latch(VirtualConsole *vc, int64_t now)
+{
+#ifdef GD_VBLANK_PACING
+    int64_t vblank;
+
+    if (gd_vblank_last(vc, &vblank) && vc->gfx.vblank_period_ns > 0) {
+        int64_t period = vc->gfx.vblank_period_ns;
+        int64_t latch = vblank + gd_vblank_phase_ns();
+
+        while (latch > now + period - gd_latch_slack_ns()) {
+            latch -= period;
+        }
+        while (latch < now - gd_latch_slack_ns()) {
+            latch += period;
+        }
+        return latch;
+    }
+#endif
+    return now;
+}
+
+static void gd_hw_gl_shown_timer(void *opaque)
+{
+    VirtualConsole *vc = opaque;
+
+    qemu_console_hw_frame_shown(vc->gfx.dcl.con);
+}
+
+/*
+ * The frame drawn last is done: report it shown at its latch point, or now
+ * when that has passed.  The guest takes this as its flip completing.
+ */
+static void gd_hw_gl_frame_drawn(VirtualConsole *vc)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    trace_gd_frame_shown(vc->gfx.frame_latch_ns - now);
+    if (vc->gfx.frame_latch_ns > now) {
+        if (!vc->gfx.shown_timer) {
+            vc->gfx.shown_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                               gd_hw_gl_shown_timer, vc);
+        }
+        timer_mod(vc->gfx.shown_timer, vc->gfx.frame_latch_ns);
+        return;
+    }
+    qemu_console_hw_frame_shown(vc->gfx.dcl.con);
+}
+
 /* Called when the guest flushes a new frame after being released. */
 void gd_hw_gl_frame_arrived(VirtualConsole *vc)
 {
@@ -770,6 +839,8 @@ void gd_hw_gl_frame_arrived(VirtualConsole *vc)
     int64_t t = now - vc->gfx.frame_released_ns;
     int64_t err;
 
+    vc->gfx.frame_latch_ns = gd_frame_latch(vc, now);
+
     if (!vc->gfx.frame_released_ns || t > vc->gfx.frame_interval_ns) {
         /* the guest was idle, not a measure of its frame turnaround */
         return;
@@ -795,6 +866,8 @@ void gd_hw_gl_release(VirtualConsole *vc)
 {
     int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
     int64_t next = vc->gfx.frame_release_ns + vc->gfx.frame_interval_ns;
+
+    gd_hw_gl_frame_drawn(vc);
 #ifdef GD_VBLANK_PACING
     int64_t vblank;
 
@@ -849,6 +922,8 @@ void gd_hw_gl_flushed(void *vcon)
         close(fence_fd);
         qemu_dmabuf_set_fence_fd(dmabuf, -1);
         gd_hw_gl_release(vc);
+    } else {
+        trace_gd_gl_flushed_nofence(fence_fd);
     }
 }
 
