diff --git a/hw/display/virtio-gpu.c b/hw/display/virtio-gpu.c
index f991baf..3920bba 100644
--- a/hw/display/virtio-gpu.c
+++ b/hw/display/virtio-gpu.c
@@ -518,6 +518,62 @@ static void virtio_gpu_transfer_to_host_2d(VirtIOGPU *g,
     }
 }
 
+/*
+ * How long a fenced flush may wait for the display, and how many such
+ * timeouts in a row make the device stop deferring (a display that never
+ * blocks, such as a hidden window) until the display unblocks again.
+ */
+#define VIRTIO_GPU_FLUSH_FENCE_TIMEOUT_MS 50
+#define VIRTIO_GPU_FLUSH_FENCE_MAX_TIMEOUTS 3
+
+static void virtio_gpu_process_fenceq(VirtIOGPU *g);
+
+static void virtio_gpu_flush_fence_timeout(void *opaque)
+{
+    VirtIOGPU *g = opaque;
+
+    if (QTAILQ_EMPTY(&g->fenceq)) {
+        return;
+    }
+    if (g->parent_obj.renderer_blocked) {
+        /* a draw is in flight: its end may answer them; look again later */
+        timer_mod(g->flush_fence_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+                  VIRTIO_GPU_FLUSH_FENCE_TIMEOUT_MS);
+        return;
+    }
+    if (g->flush_fence_timeouts < VIRTIO_GPU_FLUSH_FENCE_MAX_TIMEOUTS) {
+        g->flush_fence_timeouts++;
+    }
+    trace_virtio_gpu_flush_fence_timeout(g->flush_fence_timeouts);
+    virtio_gpu_process_fenceq(g);
+}
+
+/*
+ * A fenced RESOURCE_FLUSH of a blob on a GL scanout completes when the frame
+ * is on its way to the screen, not when the flush is queued: at the latch
+ * point of the refresh it makes when the display reports that (frame_shown),
+ * otherwise once the display has drawn it and lets the guest go on (it
+ * unblocks the renderer).  Like a page flip on real hardware, the guest learns
+ * when its frame was taken, can reuse the previous buffer from then on, and
+ * can take the answers as its vblank.  Unfenced flushes are answered at once,
+ * as before.
+ */
+static void virtio_gpu_defer_flush_fence(VirtIOGPU *g,
+                                         struct virtio_gpu_ctrl_command *cmd)
+{
+    if (!(cmd->cmd_hdr.flags & VIRTIO_GPU_FLAG_FENCE) ||
+        g->flush_fence_timeouts >= VIRTIO_GPU_FLUSH_FENCE_MAX_TIMEOUTS) {
+        return;
+    }
+    cmd->deferred = true;
+    if (!g->flush_fence_timer) {
+        g->flush_fence_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                            virtio_gpu_flush_fence_timeout, g);
+    }
+    timer_mod(g->flush_fence_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+              VIRTIO_GPU_FLUSH_FENCE_TIMEOUT_MS);
+}
+
 static void virtio_gpu_resource_flush(VirtIOGPU *g,
                                       struct virtio_gpu_ctrl_command *cmd)
 {
@@ -559,6 +615,7 @@ static void virtio_gpu_resource_flush(VirtIOGPU *g,
         }
 
         if (update_submitted) {
+            virtio_gpu_defer_flush_fence(g, cmd);
             return;
         }
         if (!within_bounds) {
@@ -1127,7 +1184,7 @@ void virtio_gpu_simple_process_cmd(VirtIOGPU *g,
         cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
         break;
     }
-    if (!cmd->finished) {
+    if (!cmd->finished && !cmd->deferred) {
         if (!g->parent_obj.renderer_blocked) {
             virtio_gpu_ctrl_response_nodata(g, cmd, cmd->error ? cmd->error :
                                             VIRTIO_GPU_RESP_OK_NODATA);
@@ -1213,10 +1270,23 @@ static void virtio_gpu_handle_gl_flushed(VirtIOGPUBase *b)
 {
     VirtIOGPU *g = container_of(b, VirtIOGPU, parent_obj);
 
-    virtio_gpu_process_fenceq(g);
+    if (!g->display_reports_shown) {
+        /* the display blocks and unblocks again: deferred fences work */
+        g->flush_fence_timeouts = 0;
+        virtio_gpu_process_fenceq(g);
+    }
     virtio_gpu_process_cmdq(g);
 }
 
+static void virtio_gpu_handle_frame_shown(VirtIOGPUBase *b)
+{
+    VirtIOGPU *g = container_of(b, VirtIOGPU, parent_obj);
+
+    g->display_reports_shown = true;
+    g->flush_fence_timeouts = 0;
+    virtio_gpu_process_fenceq(g);
+}
+
 static void virtio_gpu_handle_ctrl(VirtIODevice *vdev, VirtQueue *vq)
 {
     VirtIOGPU *g = VIRTIO_GPU(vdev);
@@ -1231,6 +1301,7 @@ static void virtio_gpu_handle_ctrl(VirtIODevice *vdev, VirtQueue *vq)
         cmd->vq = vq;
         cmd->error = 0;
         cmd->finished = false;
+        cmd->deferred = false;
         QTAILQ_INSERT_TAIL(&g->cmdq, cmd, next);
         cmd = virtqueue_pop(vq, sizeof(struct virtio_gpu_ctrl_command));
     }
@@ -1700,6 +1771,7 @@ static void virtio_gpu_device_unrealize(DeviceState *qdev)
     g_clear_pointer(&g->ctrl_bh, qemu_bh_delete);
     g_clear_pointer(&g->cursor_bh, qemu_bh_delete);
     g_clear_pointer(&g->reset_bh, qemu_bh_delete);
+    g_clear_pointer(&g->flush_fence_timer, timer_free);
     qemu_cond_destroy(&g->reset_cond);
     virtio_gpu_base_device_unrealize(qdev);
 }
@@ -1864,6 +1936,7 @@ static void virtio_gpu_class_init(ObjectClass *klass, const void *data)
     VirtIOGPUBaseClass *vgbc = &vgc->parent;
 
     vgc->handle_ctrl = virtio_gpu_handle_ctrl;
+    vgbc->frame_shown = virtio_gpu_handle_frame_shown;
     vgc->process_cmd = virtio_gpu_simple_process_cmd;
     vgc->update_cursor_data = virtio_gpu_update_cursor_data;
     vgc->resource_destroy = virtio_gpu_resource_destroy;
