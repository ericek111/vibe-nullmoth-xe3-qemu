diff --git a/src/intel/common/intel_gem.h b/src/intel/common/intel_gem.h
index 5a85ef1e5b0..059079efabd 100644
--- a/src/intel/common/intel_gem.h
+++ b/src/intel/common/intel_gem.h
@@ -32,6 +32,9 @@
 #include <stdlib.h>
 #include <unistd.h>
 #include <sys/ioctl.h>
+#ifdef __APPLE__
+#include <xf86drm.h>
+#endif
 
 #include "intel_engine.h"
 #include "drm-uapi/drm.h"
@@ -86,6 +89,8 @@ intel_ioctl(int fd, unsigned long request, void *arg)
     do {
 #ifdef HAVE_INTEL_VIRTIO
       ret = intel_virtio_ioctl(fd, request, arg);
+#elif defined(__APPLE__)
+      ret = drmNmxIoctl(fd, request, arg);
 #else
       ret = ioctl(fd, request, arg);
 #endif
diff --git a/src/intel/vulkan/anv_device.c b/src/intel/vulkan/anv_device.c
