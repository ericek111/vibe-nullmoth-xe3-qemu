diff --git a/src/util/os_drm.h b/src/util/os_drm.h
index 0390ecdb9ac..b5bb62eca3b 100644
--- a/src/util/os_drm.h
+++ b/src/util/os_drm.h
@@ -24,7 +24,11 @@ drm_ioctl(int fd, uint32_t request, void *arg)
    int ret;
 
    do {
+#ifdef __APPLE__
+      ret = drmNmxIoctl(fd, request, arg);
+#else
       ret = ioctl(fd, request, arg);
