diff --git a/src/intel/vulkan/anv_allocator.c b/src/intel/vulkan/anv_allocator.c
index ade4a8c8894..fb93f35535c 100644
--- a/src/intel/vulkan/anv_allocator.c
+++ b/src/intel/vulkan/anv_allocator.c
@@ -1872,6 +1872,95 @@ anv_device_map_bo(struct anv_device *device,
    return VK_SUCCESS;
 }
 
+
+#ifdef __APPLE__
+#include <sys/ioctl.h>
+#include "util/simple_mtx.h"
+
+struct nmx_drm_mmap {
+   uint64_t offset;
+   uint64_t size;
+   uint32_t prot;
+   uint32_t flags;
+   uint64_t addr;
+};
+struct nmx_drm_munmap {
+   uint64_t addr;
+   uint64_t size;
+};
+#define NMX_DRM_MMAP_FIXED 0x1
+#define NMX_DRM_IOCTL_MMAP _IOWR('N', 0x40, struct nmx_drm_mmap)
+#define NMX_DRM_IOCTL_MUNMAP _IOW('N', 0x41, struct nmx_drm_munmap)
+
+struct anv_nmx_map {
+   void *ret;
+   uint64_t kaddr, ksize;
+   int fd;
+   struct anv_nmx_map *next;
+};
+static struct anv_nmx_map *anv_nmx_maps;
+static simple_mtx_t anv_nmx_maps_lock = SIMPLE_MTX_INITIALIZER;
+
+void *
+anv_nmx_mmap(int fd, uint64_t mmap_offset, uint64_t obj_offset, uint64_t size, void *placed_addr)
+{
+   struct nmx_drm_mmap req = {
+      .offset = mmap_offset,
+      .size = obj_offset + size,
+      .prot = PROT_READ | PROT_WRITE,
+   };
+   if (placed_addr != NULL) {
+      req.flags = NMX_DRM_MMAP_FIXED;
+      req.addr = (uintptr_t)placed_addr - obj_offset;
+   }
+   if (intel_ioctl(fd, NMX_DRM_IOCTL_MMAP, &req) != 0) {
+      if (errno == ENOTTY) {
+         void *p = mmap(placed_addr ? (void *)(uintptr_t)req.addr : NULL, req.size, PROT_READ | PROT_WRITE,
+                        (placed_addr ? MAP_FIXED : 0) | MAP_SHARED, fd, mmap_offset);
+         return p == MAP_FAILED ? p : (char *)p + obj_offset;
+      }
+      return MAP_FAILED;
+   }
+   struct anv_nmx_map *m = malloc(sizeof(*m));
+   if (m == NULL) {
+      struct nmx_drm_munmap un = { req.addr, req.size };
+      intel_ioctl(fd, NMX_DRM_IOCTL_MUNMAP, &un);
+      errno = ENOMEM;
+      return MAP_FAILED;
+   }
+   m->ret = (char *)(uintptr_t)req.addr + obj_offset;
+   m->kaddr = req.addr;
+   m->ksize = req.size;
+   m->fd = fd;
+   simple_mtx_lock(&anv_nmx_maps_lock);
+   m->next = anv_nmx_maps;
+   anv_nmx_maps = m;
+   simple_mtx_unlock(&anv_nmx_maps_lock);
+   return m->ret;
+}
+
+bool
+anv_nmx_munmap(void *addr)
+{
+   struct anv_nmx_map *m = NULL;
+   simple_mtx_lock(&anv_nmx_maps_lock);
+   for (struct anv_nmx_map **pp = &anv_nmx_maps; *pp; pp = &(*pp)->next) {
+      if ((*pp)->ret == addr) {
+         m = *pp;
+         *pp = m->next;
+         break;
+      }
+   }
+   simple_mtx_unlock(&anv_nmx_maps_lock);
+   if (m == NULL)
+      return false;
+   struct nmx_drm_munmap un = { m->kaddr, m->ksize };
+   intel_ioctl(m->fd, NMX_DRM_IOCTL_MUNMAP, &un);
+   free(m);
+   return true;
+}
+#endif
+
 VkResult
 anv_device_unmap_bo(struct anv_device *device,
                     struct anv_bo *bo,
@@ -1893,6 +1982,10 @@ anv_device_unmap_bo(struct anv_device *device,
       assert(((uintptr_t)map & (page_size - 1)) == 0);
    }
 
+#ifdef __APPLE__
+   if (anv_nmx_munmap(map) && !replace)
+      return VK_SUCCESS;
+#endif
    if (replace) {
       map = mmap(map, map_size, PROT_NONE,
                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
